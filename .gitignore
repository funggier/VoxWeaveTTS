# Bytecode / build output
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
build/
dist/
*.egg-info/
.venv/
.env
.env.*
!.env.example
.vscode/
.idea/

# Portable runtime and generated binaries
runtime/*
!runtime/.gitkeep
*.exe

# User-generated and potentially sensitive content
models/*
!models/.gitkeep
voices/*
!voices/.gitkeep
cache/*
!cache/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
data/dictionaries/
data/filters/
data/presets/
presets/*
!presets/.gitkeep
data/profiles/
data/settings/
*.wav
*.mp3
*.flac
*.onnx
*.safetensors
*.pt
*.pth
*.ckpt
*.pkl
secrets.json
credentials.json
token.json
